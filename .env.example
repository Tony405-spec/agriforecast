# Copy this file to .env and fill in your own values.
# Never commit your actual .env file — it's already covered by .gitignore.

# OpenWeatherMap API key
# Get one at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# SoilGrids API base URL (public API, no key required by default)
# Docs: https://www.isric.org/explore/soilgrids/soilgrids-access
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0

# SQLite database path
DATABASE_PATH=data/agripredict.db

# Optional: Streamlit app environment (development / production)
APP_ENV=development
